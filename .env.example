# Modern Agriculture Web Application - Environment Variables Template
# Copy this file to .env and insert your API keys if available.
# The application automatically runs in rich offline mode if keys are omitted.

# LLM Providers (Optional - OpenAI / Groq / Ollama / OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Weather API (Optional - OpenWeatherMap. Default mock weather service works automatically)
OPENWEATHER_API_KEY=

# RAG & Retrieval Tuning
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_HYBRID_ALPHA=0.55
